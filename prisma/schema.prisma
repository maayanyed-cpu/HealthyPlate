// Healthy Plate v0 schema.
// Single hardcoded singleton User until Clerk auth lands; Children link back to it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  children  Child[]
}

model Child {
  id           String   @id @default(cuid())
  name         String
  age          Int
  gender       String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  // Onboarding step 2 — diet & allergies
  allergies    String[] @default([])
  intolerances String[] @default([])
  dietStyle    String?  // "no-restrictions" | "vegetarian" | "vegan" | "pescatarian" | "halal" | "kosher"
  notes        String?

  // Onboarding step 3 — eating habits
  habits       String[] @default([])

  meals        Meal[]
  ratings      TasteRating[]

  @@index([userId, createdAt])
}

model Food {
  id       String        @id  // matches lib/mockData FOODS ids ("carrot", "broccoli", …)
  name     String
  emoji    String
  category String        // "vegetable" | "fruit" | "protein"
  ratings  TasteRating[]
}

model TasteRating {
  id      String   @id @default(cuid())
  childId String
  child   Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  foodId  String
  food    Food     @relation(fields: [foodId], references: [id])
  rating  String   // "love" | "ok" | "maybe" | "not-really" | "hard-no" | "not-sure"
  ratedAt DateTime @default(now())

  @@unique([childId, foodId])
  @@index([childId])
}

model Meal {
  id              String         @id @default(cuid())
  childId         String
  child           Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  mealType        String         // breakfast | lunch | dinner | snack
  loggedAt        DateTime       @default(now())
  status          String         // pending | complete
  beforePhotoUrl  String?        // Vercel Blob URL of the before-shot
  afterPhotoUrl   String?        // Vercel Blob URL of the after-shot
  detected        DetectedFood[]

  @@index([childId, loggedAt])
}

model DetectedFood {
  id           String   @id @default(cuid())
  mealId       String
  meal         Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodKey      String   // e.g. "carrot", "broccoli"
  name         String
  emoji        String
  portionGrams Int
  confidence   Int      // 0–100
  phase        String   // before | after
  percentEaten Int?     // populated when after-phase is saved
  createdAt    DateTime @default(now())

  @@index([mealId])
}
